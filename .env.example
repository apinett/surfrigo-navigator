# Variables públicas del navegador (no contienen secretos).
# Las provee Lovable Cloud automáticamente; este archivo documenta el contrato.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

